<form class="search__form search__form--centered">
  <div class="search__bar">
    <input
      type="text"
      name="q"
      value="<%= @query %>"
      placeholder="<%= t("search_placeholder", total: @total) %>"
      class="search__text-input"
      autocomplete="off"
    >
    <input type="submit" value="<%= t("search_button") %>" class="search__button">
  </div>
  <%# Without JavaScript every filter simply stays unfolded and keeps working. %>
  <% filters_open = (@from.values + @to.values).any?(&:present?) %>
  <section class="search__filters">
    <h3 class="search__filters-title">
      <%# The button needs JavaScript to do anything, so browsers without it get
          the plain heading and the unfolded filters underneath instead. %>
      <button
        type="button"
        class="search__filters-toggle"
        aria-controls="search_filters_list"
        aria-expanded="<%= filters_open %>"
      ><%= t("search_filters") %></button>
      <span class="search__filters-heading"><%= t("search_filters") %></span>
    </h3>
    <div class="search__filters-list <%= "search__filters-list--open" if filters_open %>" id="search_filters_list">
      <%= render "date_filter", prefix: "from", legend: t("search_date_from"), parts: @from %>
      <%= render "date_filter", prefix: "to", legend: t("search_date_to"), parts: @to %>
    </div>
  </section>
</form>
<% if @query %>
  <% cache [controller.action_name, query_cache_key(@query, @from_value, @to_value), @archive_files.current_page] do %>
    <% if @pagination_cache[:total_count] > 0 %>
      <h3><%= @pagination_cache[:total_count] -%> Objekte gefunden.</h3>
      <div class="pagination">
        <%= paginate @archive_files, total_pages: @pagination_cache[:total_pages] %>
      </div>
      <hr>
      <% @archive_files.each do |archive_file| %>
        <%= render ResultComponent.new(query: @query, archive_file: archive_file) %>
        <hr>
      <% end %>
      <div class="pagination">
        <%= paginate @archive_files, total_pages: @pagination_cache[:total_pages] %>
      </div>
    <% else %>
      <hr>
      <h3>Keine Akten gefunden.</h3>
    <% end %>
  <% end %>
<% else %>
  <hr class="title-spacer">
  <h2>Was ist Bundessuche?</h2>
  <p>
    Bundessuche ist ein Projekt von <a href="https://emi.industries">Michael Emhofer</a> und bietet eine einfache und schnelle Möglichkeit, die Bestände des Bundesarchivs zu durchsuchen.
    Dieses Angebot richtet sich vor allem an Personen, die für ihre Recherechen exakte textuelle Übereinstimmungen suchen und große Mengen an Ergebnissen schnell sichten möchten.
    Die hierfür benötigten Erschließungsinformationen stammen aus dem <a href="https://www.bundesarchiv.de/DE/Content/Artikel/Ueber-uns/Aus-unserer-Arbeit/open-data.html">Open-Data-Angebot</a> des Bundesarchivs.
  </p>
  <p>
    Weitere Optionen für die Suche in den Beständen des Bundesarchivs sind <a href="https://www.archivesportaleurope.net">Archives Portal Europe</a>,
    <a href="https://www.archivportal-d.de">Archivportal-D</a> und <a href="https://invenio.bundesarchiv.de">Invenio</a>.
    Invenio ist ein Angebot des Bundesarchivs und ist bei Treffern in Bundessuche verlinkt. Dort kann das Archivgut eingesehen und bestellt werden.
  </p>
<% end %>
